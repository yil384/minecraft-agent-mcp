# minecraft-agent-mcp: settings for compose.yaml. ./setup.sh copies this file to .env and fills in the lines marked
# (setup). Every setting is described in docs/CONFIG.md. After a change: docker compose up -d

# ---------------------------------------------------------------------------------------------------------- required
# The Minecraft EULA: read it yourself at https://aka.ms/MinecraftEULA. Nothing from Mojang is downloaded and the server
# does not start until you set this to true (./setup.sh asks you).
MINECRAFT_EULA=false

# What the server shows of a game:
#   off       play only; no Minecraft account needed
#   local     a watch page in your browser with the real game picture and the HUD (needs your own Minecraft: Java
#             Edition account for the camera, and an x86-64 machine with about 4 free cores)
#   facebook  a live video on your own Facebook profile or Page, started only when a client calls live_view
#             (the camera as for local, plus your own Meta developer app; see docs/CONFIG.md, "Facebook")
LIVE_VIEW=off

# The key in the MCP URL: http://127.0.0.1:8787/mcp/<MCP_ACCESS_KEY>. Anyone with the URL can play on this server, so
# treat it like a password. (setup: openssl rand -hex 16)
MCP_ACCESS_KEY=
# The key of the camera's watch page (LIVE_VIEW=local): http://127.0.0.1:8787/live/<WATCH_KEY>/. It only lets people
# watch, never play. (setup: openssl rand -hex 16; empty: derived from MCP_ACCESS_KEY)
WATCH_KEY=
# The operator's token for /log and POST /admin/stop (at least 24 characters). (setup)
WEB_ADMIN_TOKEN=

# ---------------------------------------------------------------------------------------------------------- the server
SERVER_NAME=Agent game server
# Who runs it, shown in the pages' footer ("Run by ..."); empty: nothing
SITE_OPERATOR=
# The host port (./setup.sh --port), published on WEB_BIND: 127.0.0.1 keeps it on this machine (a tunnel or your own
# reverse proxy makes it public); a LAN address of this machine opens it to your network (README, "Server on another
# machine")
WEB_PORT=8787
WEB_BIND=127.0.0.1
# Your stable https URL, if you have one (a named tunnel, a reverse proxy); empty: links follow the host each request
# came in on
WEB_PUBLIC_URL=
# Host names the server answers to besides 127.0.0.1/localhost, IP addresses, WEB_PUBLIC_URL's host and the quick
# tunnels' names (a guard against DNS rebinding); comma-separated, ".example.org" for its subdomains
WEB_ALLOWED_HOSTS=
# off | cloudflare (the Cloudflare tunnel sets it) | 1-5 (proxies that append to X-Forwarded-For): where a request's
# address comes from, for the per-address limits
WEB_TRUST_PROXY=off
# The proxy's own address(es): forwarded headers count only on its connections (./setup.sh --tunnel sets 127.0.0.1)
WEB_TRUSTED_PROXIES=
# A game ends after GAME_LEASE_MIN minutes, or after GAME_IDLE_MIN minutes without an MCP call
GAME_LEASE_MIN=60
GAME_IDLE_MIN=10
# Bots at once (each one is a process of 0.3-1 GB)
MAX_GAMES=2
# What the bot does by itself between calls: advise (the default: your agent plans everything; the body has only its
# reflexes and gives advice in every reply) | full (it also shelters, eats, crafts spares) | off (reflexes only)
BOT_CARE=advise
# The zero-JS pages (/play, /api) that start bots without MCP: off, unless you want people to use them
WEB_GUEST_PAGES=off

# ---------------------------------------------------------------------------------------------------------- sharing it
# For a server other people play on (README, "Hosting a public server"); the defaults suit one person.
# Your own key (16+ letters, digits, _ or -; openssl rand -hex 16), different from MCP_ACCESS_KEY: an MCP connection
# that adds ?owner=<key> to the MCP URL (or sends the header X-Owner-Key) is first in line for the camera and a bot,
# plays while PUBLIC_PLAY is off, and is held to none of the per-address limits or bans
MCP_OWNER_KEY=
# false: start_game answers CLOSED to everyone but the owner (POST /admin/public switches it at once)
PUBLIC_PLAY=true
# false: say (in-game chat) only for the owner; other agents' words reach viewers through why and plan
PUBLIC_CHAT=true
# New games one address may start in an hour, and requests one MCP session may send in a minute
WEB_MCP_STARTS_PER_HOUR=10
WEB_MCP_REQUESTS_PER_MINUTE=120
# Address hashes that may not play (GET /admin/games shows them), comma-separated; POST /admin/ban adds more
WEB_BANNED_IPS=

# ---------------------------------------------------------------------------------------------------------- the world
# Paper 1.21.4. PAPER_SEED empty: a random world
PAPER_SEED=
PAPER_DIFFICULTY=normal
# cycle | locked (always morning)
PAPER_DAYLIGHT=cycle
PAPER_NETHER=true
# The world border's width in blocks (keeps the world on disk bounded)
PAPER_BORDER=20000
PAPER_MEMORY=3G
# bStats (bundled with Paper) sends anonymous server statistics to bstats.org when true
PAPER_BSTATS=false

# ---------------------------------------------------------------------------------------------------------- the camera
# (LIVE_VIEW=local or facebook)
# cpu (Mesa llvmpipe, about 4 cores) | gpu (an NVIDIA GPU: compose.gpu.yaml, docs/CONFIG.md)
CAMERA_GL=cpu
# Your own Azure app's client id for the camera account's sign-in (README, "Troubleshooting"); empty: the default
# device-code sign-in
CAMERA_MSA_CLIENT_ID=
# third (over the bot's shoulder) | first (in its head)
CAMERA_VIEW=third
# Client mods (downloaded at the camera's first start): sodium (much faster on the CPU; licensed under the PolyForm
# Shield License 1.0.0, which is source-available, not open source) | none (the vanilla client)
CAMERA_MODS=sodium
# ui (square: the game and the HUD) | terminal (vertical) | landscape (the game alone)
STREAM_LAYOUT=ui
STREAM_BITRATE_K=3500
# The CC0 music bed under the game's sound
STREAM_MUSIC=true
# The HUD: b (the default: toasts, banners and the action bar over the game, a broadcast package under it) | final
# (the earlier design)
STREAM_HUD=b
# A logo at the top right of the video and on the live page's poster: off | plain (a light logo with a hard shadow) |
# card (a light logo on a white card). STREAM_LOGO_FILE: your PNG (a path under assets/, e.g. brand/mine.png, or a
# name in assets/ui); empty: the project's pixel logo, which is not under the Apache licence (NOTICE)
STREAM_LOGO=off
STREAM_LOGO_FILE=
# true: keep each filmed game's recordings in ./data/recordings (the clean game, the stream, the HUD's timeline);
# old ones go after RECORD_KEEP_DAYS or beyond RECORD_MAX_GB (docs/CONFIG.md, "Recordings")
RECORD=false
CAMERA_CPUS=6
CAMERA_MEM=3g

# ---------------------------------------------------------------------------------------------------------- Facebook
# (LIVE_VIEW=facebook) The token itself is in ./secrets/fb-token (mode 600), written by ./setup.sh --facebook.
# me (your profile; a long-lived user token, about 60 days) | page (a Page at least 60 days old: FB_PAGE_ID)
FB_TARGET=me
FB_PAGE_ID=
# The embedded player plays only public videos
FB_PRIVACY=EVERYONE
# Live videos started at most per hour and per 24 hours: Facebook may lock an account that starts many automated public
# live videos in a short time, so keep these low
FB_MAX_PER_HOUR=4
FB_MAX_PER_DAY=12
# Delete each live video this long after its game (the default for FB_TARGET=me)
FB_DELETE_AFTER=true
FB_DELETE_DELAY_S=600
# Empty: "<SERVER_NAME>: an AI agent plays Minecraft"
FB_TITLE=
FB_DESCRIPTION=

# ---------------------------------------------------------------------------------------------------------- setup
# Written by ./setup.sh; rarely edited
# The Compose project's name (./setup.sh --name): a second copy on one machine needs its own, and its own WEB_PORT
COMPOSE_PROJECT_NAME=mcagent
# Your user and group id: the containers run as you, so ./data stays yours
RUN_UID=1000
RUN_GID=1000
# Random; marks this install's Facebook live videos, so a crash sweep never touches another install's
INSTALL_ID=
# Random; the agent and the camera service share it (the camera's control API answers nobody else)
STREAM_SERVICE_TOKEN=
# camera (LIVE_VIEW=local or facebook), and tunnel for the Cloudflare quick tunnel; comma-separated
COMPOSE_PROFILES=
# 1 while ./setup.sh --tunnel set WEB_TRUST_PROXY and WEB_TRUSTED_PROXIES (--no-tunnel undoes them then)
SETUP_TUNNEL_TRUST=
